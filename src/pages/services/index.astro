---
import { services } from "@/data/services";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import Section from "@/components/Section.astro"
import SectionHeading from "@/components/SectionHeading.astro";
import ServiceGrid from "@/components/ServiceGrid.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import servicesImage from "@/assets/images/Services.webp"
import FeatureGrid from "@/components/FeatureGrid.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import ProcessGrid from "@/components/ProcessGrid.astro";
import ProcessStep from "@/components/ProcessStep.astro";
import Faq from "@/components/Faq.astro";
import Cta from "@/components/Cta.astro";
import {servicesFAQ} from "@/data/servicesFAQ.ts"
import ButtonLink from "@/components/ButtonLink.astro";
import CareServiceGrid from "@/components/CareServiceGrid.astro";

const treatmentServices = Object.entries(services).filter(
  ([, service]) => service.category === "treatments"
);

const careServices = Object.entries(services).filter(
  ([, service]) => service.category === "care"
);

const consultationServices = Object.entries(services).filter(
  ([, service]) => service.category === "consultation"
);

---

<BaseLayout
    title="خدمات تخصصی آنکولوژی و هماتولوژی | شیمی‌درمانی، ایمونوتراپی و مشاوره سرطان"
    description="ارائه خدمات تخصصی خون و سرطان شامل شیمی‌درمانی، ایمونوتراپی، درمان هدفمند، نمونه‌برداری مغز استخوان، تزریق آهن و مشاوره تخصصی آنکولوژی."
    image="/default-og-image.jpg"
	>
    <Hero 
    badge="مطب فوق تخصصی هماتولوژی و آنکولوژی"
    titleLine1="خدمات تخصصی"
    titleLine2="آنکولوژی و هماتولوژی"
    description="ارائه خدمات تشخیصی، درمانی و مراقبتی برای بیماران مبتلا به سرطان، بیماری‌های خونی و اختلالات هماتولوژیک"
    image={servicesImage}
    alt="محیط گرم و حرفه‌ای مطب تخصصی آنکولوژی و هماتولوژی"
    >
    </Hero>
    <Section>
      <div class="service-category">
        <SectionHeading
            title="درمان‌های تخصصی سرطان و بیماری‌های خون"
            description="خدمات تشخیصی، درمانی و اقدامات تخصصی برای بیماران مبتلا به سرطان، بیماری‌های خون و سایر اختلالات هماتولوژیک."
        />

        <ServiceGrid>

            {treatmentServices.map(([slug, service]) => (

                <ServiceCard
                    title={service.title}
                    description={service.description}
                    href={`/services/${slug}`}
                    icon={service.icon}
                />

            ))}

        </ServiceGrid>
      </div>
      <div class="service-category">
        <SectionHeading
          title="مراقبت‌ها و خدمات درمانی"
          description="خدمات حمایتی و مراقبتی با هدف افزایش کیفیت زندگی، تسهیل روند درمان و ارائه مراقبت در منزل."
          align="right"
        />

        <CareServiceGrid>

          {careServices.map(([slug, service]) => (

              <ServiceCard
                  title={service.title}
                  description={service.description}
                  href={`/services/${slug}`}
                  icon={service.icon}
              />

          ))}

        </CareServiceGrid>
      </div>
      <div class="service-category">

  <SectionHeading
    title="مشاوره تخصصی و خدمات غیرحضوری"
    description="ارائه مشاوره تخصصی برای بررسی پرونده‌های پزشکی، دریافت نظر دوم و همراهی بیماران در داخل و خارج از کشور."
  />

  <ServiceGrid>

    {consultationServices.map(([slug, service]) => (

      <ServiceCard
        title={service.title}
        description={service.description}
        href={
          slug === "online-consultation"
            ? "/consultation"
            : `/services/${slug}`
        }
        icon={service.icon}
      />

    ))}

  </ServiceGrid>

</div>
    </Section>
    
    <Section
    background="secondary">
    <SectionHeading 
    title="رویکرد ما در ارائه خدمات درمانی"
    subtitle="ارائه خدمات تخصصی با رویکردی بیمارمحور"
    >
    </SectionHeading>
    <FeatureGrid>
        <FeatureCard 
        title="درمان مبتنی بر شواهد"
        description="استفاده از جدیدترین راهنماهای علمی و استانداردهای بین‌المللی درمان"
        icon="evidence">
    </FeatureCard>
    <FeatureCard
    title="برنامه درمانی فردمحور"
    description="طراحی برنامه درمانی متناسب با شرایط و نیازهای هر بیمار"
    icon="personalized"
    >
    </FeatureCard>
    <FeatureCard
    title="پیگیری مستمر"
    description="ارزیابی منظم روند درمان و مدیریت عوارض احتمالی"
    icon="followup"
    >
    </FeatureCard>
    <FeatureCard
    title="مراقبت جامع"
    description="توجه به کیفیت زندگی بیمار در تمام مراحل درمان"
    icon="life"
    >
    </FeatureCard>
    </FeatureGrid>
    </Section>
    <Section>
        <SectionHeading
        title="روند مراجعه بیمار"
        subtitle="مراحل دریافت خدمات تخصصی">
        </SectionHeading>
        <ProcessGrid>
            <ProcessStep
            number={1}
            title="رزرو نوبت"
            description="از طریق تماس تلفنی"
            icon="calendarCheck"
            >
            </ProcessStep>
            <ProcessStep
            number={2}
            title="ویزیت اولیه"
            description="بررسی سوابق و مدارک پزشکی"
            icon="userPlus"
            >
            </ProcessStep>
            <ProcessStep
            number={3}
            title="تعیین برنامه درمانی"
            description="تفسیر نتایج، بررسی گزینه‌های درمان و انتخاب مسیر مناسب"
            icon="stethoscope"
            >
            </ProcessStep>
            <ProcessStep
            number={4}
            title="شروع درمان"
            description="اجرای برنامه درمانی و مدیریت عوارض"
            icon="pill"
            >
            </ProcessStep>
            <ProcessStep
            number={5}
            title="پیگیری"
            description="ارزیابی و مراقبت مستمر"
            icon="calendarClock"
            >
            </ProcessStep>
        </ProcessGrid>
    </Section>
    <Section background="secondary">
        <SectionHeading 
        title="سوالات متداول">
        </SectionHeading>
        <Faq 
        items={servicesFAQ}>
        </Faq>

    </Section>
    <Cta 
    title="برای انتخاب بهترین مسیر درمان، با ما در ارتباط باشید"
    description="جهت دریافت مشاوره تخصصی، رزرو نوبت حضوری یا بررسی پرونده پزشکی اقدام کنید."
    >
    <ButtonLink
    href="/consultation"
    text="مشاوره آنلاین"
  />

  <ButtonLink
    href="/visit"
    variant="secondary"
    text="رزرو نوبت"
  />
    </Cta>
</BaseLayout>

<style>
.service-category + .service-category {
    margin-top: var(--space-3xl);
}
</style>