---
import BaseLayout from '../layouts/BaseLayout.astro';
import MedicalClinicSchema from "@/components/seo/MedicalClinicSchema.astro";
import HomeHero from '@/components/home/HomeHero.astro';
import HomeIntroduction from "@/components/HomeIntroduction.astro";
import HomeServices from '@/components/HomeServices.astro';
import HomeWhyChoose from "@/components/HomeWhyChoose.astro";
import MeetTheDoctors from "@/components/about/MeetTheDoctors.astro"
import HomeTreatmentJourney from "@/components/HomeTreatmentJourney.astro"
import HomeArticles from "@/components/HomeArticles.astro"
import PatientCenteredCare from "@/components/PatientCenteredCare.astro"
import Cta from "@/components/Cta.astro"
import ButtonLink from "@/components/ButtonLink.astro"
---

<BaseLayout 
	title= "درمان سرطان و بیماری‌های خون تهران | دکتر فرداد و انصاری‌نژاد" 
	description= "مرکز تخصصی هماتولوژی و آنکولوژی دکتر فرشید فرداد و دکتر نفیسه انصاری‌نژاد. ارائه خدمات تشخیص و درمان سرطان، شیمی‌درمانی، درمان‌های نوین سرطان و بیماری‌های خون در تهران با رویکردی علمی و بیمارمحور."
	image="/og-home.jpg"
	>
	<Fragment slot="head">
        <MedicalClinicSchema />
    </Fragment>
	<HomeHero />
	<HomeIntroduction />
	<HomeServices />
	<HomeWhyChoose />
	
	
	<MeetTheDoctors

  		subtitle="تیم درمانی"

  		title="پزشکان متخصص شما"

  		description="با پزشکان فوق تخصص خون و آنکولوژی آشنا شوید و مسیر درمان خود را با اطمینان بیشتری آغاز کنید."
  

	/>
	<HomeTreatmentJourney />
	<HomeArticles />
	<PatientCenteredCare />
	<Cta
  title="برای شروع مسیر درمان، با ما در ارتباط باشید"
  description="اگر درباره تشخیص، درمان یا دریافت نظر دوم پزشکی نیاز به راهنمایی دارید، می‌توانید برای مشاوره آنلاین یا تعیین وقت ویزیت اقدام کنید."
>

  <ButtonLink
    href="/visit"
    text="درخواست نوبت حضوری"
  />

  <ButtonLink
    href="/consultation"
    variant="secondary"
    text="مشاوره آنلاین"
  />

</Cta>
</BaseLayout>

