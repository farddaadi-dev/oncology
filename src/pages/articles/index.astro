---
import { getCollection } from "astro:content";
import CollectionSchema from "@/components/seo/CollectionSchema.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

import SectionHeading from "@/components/SectionHeading.astro";

import Hero from "@/components/Hero.astro";

import Section from "@/components/Section.astro";

import BlogSearch from "@/components/blog/BlogSearch.astro";

import CategoryChips from "@/components/blog/CategoryChips.astro";
import ArticleImage from "@/assets/images/articles.webp"
import FeaturedArticle from "@/components/blog/FeaturedArticle.astro";
import ButtonLink from "@/components/ButtonLink.astro"
import BlogGrid from "@/components/blog/BlogGrid.astro";
import Cta from "@/components/Cta.astro"


const posts = await getCollection(
    "blog",
    ({ data }) => !data.draft
);


const sortedPosts = posts.sort(
    (a, b) =>
        b.data.publishDate.getTime()
        -
        a.data.publishDate.getTime()
);


const featuredPost =
    sortedPosts.find(
        (post) => post.data.featured
    )
    ??
    sortedPosts[0];


const remainingPosts =
    sortedPosts.filter(
        (post) =>
            post.id !== featuredPost?.id
    );

---

<BaseLayout
    title="مقالات آموزشی هماتولوژی و آنکولوژی"
    description="مقالات آموزشی معتبر درباره سرطان، بیماری‌های خون، شیمی‌درمانی، ایمونوتراپی، درمان‌های هدفمند، مراقبت از بیماران و آخرین دستاوردهای پزشکی."
    image="/og-articles.jpg"
>
<Fragment slot="head">
    <CollectionSchema
        title="مقالات آموزشی هماتولوژی و انکولوژی"
        description="مقالات آموزشی معتبر درباره سرطان، بیماری‌های خون، روش‌های درمان و مراقبت از بیماران."
    />
</Fragment>

<Hero
    badge="مقالات آموزشی"
    titleLine1="دانش پزشکی"
    titleLine2="برای تصمیم‌های آگاهانه"
    description="مطالب معتبر پزشکی درباره سرطان، بیماری‌های خون، روش‌های درمان و مراقبت از بیماران."
    showButtons={false}
    image={ArticleImage}
/>


<Section>

    <BlogSearch />

</Section>


<Section background="secondary">

    <CategoryChips />

</Section>
<Section>
<SectionHeading
    title="پیشنهاد پزشک"
    subtitle="مقاله‌ای منتخب برای افزایش آگاهی بیماران و همراهان"
    ></SectionHeading>



{
    featuredPost && (

        

            <FeaturedArticle
                post={featuredPost}
            />

        
        

    )
}

</Section>
<Section>
    <SectionHeading
        title="آخرین مقالات آموزشی"
        subtitle="جدیدترین مطالب درباره سرطان، بیماری‌های خون و روش‌های درمان"
        ></SectionHeading>
    <BlogGrid
        posts={remainingPosts}
    />

</Section>

<Cta
title="سوالی درباره شرایط درمان خود دارید؟"
description="برای دریافت نظر تخصصی یا بررسی پرونده پزشکی اقدام کنید."
>
    <ButtonLink
    href="/visit"
    text="درخواست نوبت حضوری"
  />

  <ButtonLink
    href="/consultation"
    text="مشاوره آنلاین"
    variant="secondary"
  />

    

</Cta>
</BaseLayout>