---
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ServiceGrid from "@/components/ServiceGrid.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import ButtonLink from "@/components/ButtonLink.astro";

import type { ServiceSlug } from "@/data/services";

import { services } from "@/data/services";



const featuredServices = [
  "medical-oncology",
  "hematology",
  "online-consultation",
  "procedures",
  "ambulatory",
  "international-consultation"
] satisfies ServiceSlug[];

const selectedServices = featuredServices.map(
  (slug) => ({
    slug,
    ...services[slug]
  })
);

---

<Section background ="secondary">

  <SectionHeading
  title="خدمات تخصصی ما"
  subtitle="خدمات درمانی"
  description="ارائه خدمات تشخیصی، درمانی و مراقبتی در حوزه سرطان و بیماری‌های خون"
/>

  <ServiceGrid>

    {
      selectedServices.map((service) => (

        <ServiceCard
          title={service.title}
          description={service.description}
          href={`/services/${service.slug}`}
          icon={service.icon}
        />

      ))
    }

  </ServiceGrid>


  <div class="services-button">

    <ButtonLink
      href="/services"
      text="مشاهده همه خدمات"
      
    />

  </div>


</Section>


<style>

.services-button {

display:flex;

justify-content:center;

margin-top:3rem;

}

</style>