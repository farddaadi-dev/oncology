---
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import InfoCard from "@/components/InfoCard.astro";

import { benefits } from "@/data/benefits";
---

<Section>

    <SectionHeading
        subtitle="مزیت‌های ما"
        title="تعهد ما به مراقبت بهتر"
        description="در کنار دانش تخصصی و تجربه بالینی، توجه به نیازهای فردی، ارتباط شفاف و همراهی مداوم بخش مهمی از مراقبت ماست."
    />


    <div class="benefits-grid" id="benefits-grid">

        {
            benefits.map((benefit) => (

                <InfoCard
                    title={benefit.title}
                    icon={benefit.icon}
                    
                >
                    <p>
                        {benefit.description}
                    </p>

                </InfoCard>

            ))
        }

    </div>

</Section>


<style>

.benefits-grid {

display:grid;

grid-template-columns:
    repeat(3, minmax(0, 1fr));

gap:2rem;

}


</style>


<style is:global>

@media (max-width: 992px) {

    #benefits-grid {

        grid-template-columns:
            repeat(2, 1fr);

    }

}


@media (max-width: 768px) {

    #benefits-grid {

        grid-template-columns:
            1fr;

    }

}

</style>