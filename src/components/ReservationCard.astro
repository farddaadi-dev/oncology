---
import ButtonLink from './ButtonLink.astro';
interface Props {
  title: string;
  phone: string;
  address: string;
  href: string;
}

const { title, phone, href, address } = Astro.props;
---

<article class="service-card">
  

  <h3>{title}</h3>

  <p>{address}</p>
  <p>{phone}</p>
  <div class="button">
  <ButtonLink 
  href={href}
  text='تماس'
  
  >
  </ButtonLink>
  </div>
</article>

<style>
  .service-card {
    background: white;
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow);
    border: 2px solid var(--color-brand-green);

    display: flex;
    flex-direction: column;
    gap: 1rem;

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;

    height: 100%;
  }

  

  
  .service-card h3 {
    margin: 0;
    text-align: center;
    font-size: 1.4rem;
    font-weight: 700;

    color: var(--color-brand-accent);
  }

  .service-card p {
    margin: 0;

    color: var(--color-text-primary);
    line-height: 1.8;
    font-size: var(--text-lead);

    flex-grow: 1;
  }
  .button {
    display: flex;
    justify-content: center;
    align-items: center;
  }
</style>