---
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import FeatureGrid from "@/components/FeatureGrid.astro";
import FeatureCard from "@/components/FeatureCard.astro";
---

<Section>

  <SectionHeading
  title="چرا ما را انتخاب کنید؟"
  subtitle="مزایای درمان"
  description="ترکیبی از دانش تخصصی، تجربه بالینی و مراقبت فردمحور برای همراهی شما در مسیر درمان"
/>

  <FeatureGrid>

    <FeatureCard
      title="تجربه تخصصی"
      description="سال‌ها تجربه در تشخیص و درمان سرطان و بیماری‌های خونی با تمرکز بر مراقبت دقیق و علمی."
      icon="stethoscope"
    />

    <FeatureCard
      title="درمان مبتنی بر شواهد"
      description="استفاده از جدیدترین راهنماهای علمی و استانداردهای معتبر درمانی برای تصمیم‌گیری بهتر."
      icon="evidence"
    />

    <FeatureCard
      title="درمان فردمحور"
      description="طراحی مسیر درمانی متناسب با شرایط، نیازها و اولویت‌های هر بیمار."
      icon="personalized"
    />

    <FeatureCard
      title="همراهی مستمر"
      description="پیگیری روند درمان و حمایت از بیمار و خانواده در مراحل مختلف مسیر درمان."
      icon="heartPulse"
    />

  </FeatureGrid>

</Section>