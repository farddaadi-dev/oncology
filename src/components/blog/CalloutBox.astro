---
import { icons } from '@/data/icons';

interface Props {

title: string;

variant?: "info" | "tip" | "warning" | "success";

}

const {

title,

variant = "info"

} = Astro.props;

const variantIcons = {
  info: icons.info2,
  tip: icons.tip,             
  warning: icons.warning,
  success: icons.success,
};

const Icon = variantIcons[variant];
---

<aside
class:list={[
    "callout",
    `callout--${variant}`
]}
>

<div class="callout__header">

    <span class="callout__icon">

        <Icon />

    </span>

    <h3>

        {title}

    </h3>

</div>

<div class="callout__content">

    <slot />

</div>

</aside>

<style>

.callout{

border-inline-start:5px solid;

border-radius:var(--radius-lg);

padding:var(--space-xl);

margin-block:var(--space-2xl);

background:var(--color-bg-primary);

box-shadow:var(--shadow);

}

.callout__header{

display:flex;

align-items:center;

gap:var(--space-md);

margin-bottom:var(--space-md);

}

.callout__header h3{

margin:0;

font-size:var(--text-lg);

}

.callout__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.callout__icon :global(svg) {
  width: 4rem;
  height: 4rem;
}

.callout__content>:last-child{

margin-bottom:0;

}

.callout--info{

border-color:var(--color-brand-green);

}

.callout--tip{

border-color:var(--color-brand-accent);

}

.callout--warning{

border-color:#c97b00;

}

.callout--success{

border-color:#5d8b67;

}

</style>